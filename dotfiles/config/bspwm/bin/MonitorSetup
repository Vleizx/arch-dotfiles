#!/bin/sh

set -- $(xrandr --query | awk '$2 == "connected" {print $1}')
monitor_count=$#

case "$monitor_count" in
    0)
        exit 0
        ;;
    1)
        bspc monitor "$1" -d 1 2 3 4 5 6 7 8 9 0
        ;;
    2)
        primary="$1"
        secondary="$2"

        xrandr --output "$primary" --primary --auto \
               --output "$secondary" --right-of "$primary" --auto
        bspc monitor "$primary" -d 1 2 3 4 5
        bspc monitor "$secondary" -d 6 7 8 9 0
        bspc wm -O "$primary" "$secondary"
        ;;
    3)
        bspc monitor "$1" -d 1 2 3 4
        bspc monitor "$2" -d 5 6 7
        bspc monitor "$3" -d 8 9 0
        bspc wm -O "$1" "$2" "$3"
        ;;
    4)
        bspc monitor "$1" -d 1 2 3
        bspc monitor "$2" -d 4 5 6
        bspc monitor "$3" -d 7 8
        bspc monitor "$4" -d 9 0
        bspc wm -O "$1" "$2" "$3" "$4"
        ;;
    *)
        printf '%s\n' "More than four monitors are not supported by Valerie." >&2
        ;;
esac
